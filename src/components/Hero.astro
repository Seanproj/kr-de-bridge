---
import { href } from "../lib/data";
interface Props { stats: { cards: number; official: number; verified: number; partial: number; draft: number } }
const { stats } = Astro.props;
---
<section class="grain relative isolate overflow-hidden" style="background:var(--hero);color:var(--hero-ink)">
  <!-- 배경 광원 -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-40 -top-40 h-[520px] w-[520px] rounded-full opacity-40" style="background:radial-gradient(circle,#1d4ed8,transparent 65%)"></div>
    <div class="absolute -right-40 top-10 h-[520px] w-[520px] rounded-full opacity-30" style="background:radial-gradient(circle,#f2b200,transparent 65%)"></div>
    <div class="absolute bottom-[-280px] left-1/2 h-[520px] w-[720px] -translate-x-1/2 rounded-full opacity-25" style="background:radial-gradient(circle,#e0383e,transparent 65%)"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(ellipse at 50% 40%,#000 30%,transparent 75%)"></div>
  </div>

  <div class="wrap relative pt-12 pb-10 sm:pt-20 sm:pb-14">
    <p class="rise eyebrow !text-white/55">KOREA ⇄ DEUTSCHLAND · 행정 가이드</p>
    <h1 class="rise d1 mt-4 text-[38px] leading-[1.08] font-extrabold tracking-[-0.035em] sm:text-[64px]">
      한국 일은 <span class="whitespace-nowrap">독일에서,</span><br />
      독일 일은 <span class="bridge-text whitespace-nowrap">한국인의 눈으로.</span>
    </h1>
    <p class="rise d2 mt-5 max-w-[540px] text-[16px] leading-relaxed text-white/70 sm:text-[17px]">
      필요 서류 → 어디서 → 얼마나 걸리는지 → <b class="font-semibold text-white">자주 하는 실수</b>까지.
      상황만 고르면 해야 할 일이 순서대로 보여요.
    </p>

    <!-- 다리 -->
    <div class="relative mt-8 sm:mt-10" aria-hidden="true">
      <svg viewBox="0 0 1000 190" class="h-auto w-full overflow-visible">
        <defs>
          <linearGradient id="arc" x1="0" x2="1">
            <stop offset="0" stop-color="#3b6cff" /><stop offset=".52" stop-color="#ff4d55" /><stop offset="1" stop-color="#ffc400" />
          </linearGradient>
          <filter id="glow" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
        </defs>
        <path d="M40 170 C 260 -30, 740 -30, 960 170" fill="none" stroke="url(#arc)" stroke-width="10" opacity=".45" filter="url(#glow)" class="draw" style="--len:1300" />
        <path id="bridge-path" d="M40 170 C 260 -30, 740 -30, 960 170" fill="none" stroke="url(#arc)" stroke-width="3" stroke-linecap="round" class="draw" style="--len:1300" />
        <g stroke="#fff" stroke-opacity=".16" stroke-width="1.2">
          {Array.from({ length: 19 }, (_, i) => {
            const t = (i + 1) / 20;
            const x = (1 - t) ** 3 * 40 + 3 * (1 - t) ** 2 * t * 260 + 3 * (1 - t) * t ** 2 * 740 + t ** 3 * 960;
            const y = (1 - t) ** 3 * 170 + 3 * (1 - t) ** 2 * t * -30 + 3 * (1 - t) * t ** 2 * -30 + t ** 3 * 170;
            return <line x1={x} y1={y} x2={x} y2="170" />;
          })}
        </g>
        <line x1="10" y1="170" x2="990" y2="170" stroke="#fff" stroke-opacity=".25" stroke-width="1.5" />
        <circle r="5" fill="#fff" style="offset-path:path('M40 170 C 260 -30, 740 -30, 960 170');animation:travel 5.5s cubic-bezier(.45,0,.55,1) 1.6s infinite alternate both" />
        <g>
          <circle cx="40" cy="170" r="9" fill="#3b6cff" class="ping" /><circle cx="40" cy="170" r="7" fill="#3b6cff" />
          <circle cx="960" cy="170" r="9" fill="#ffc400" class="ping" style="animation-delay:1.2s" /><circle cx="960" cy="170" r="7" fill="#ffc400" />
        </g>
      </svg>
      <div class="mt-3 flex items-start justify-between font-mono text-[11px] text-white/60 sm:text-[12px]">
        <div><span class="text-[18px] leading-none">🇰🇷</span> SEOUL<br /><b class="text-[15px] text-white sm:text-[18px]" data-clock="Asia/Seoul">--:--</b> KST</div>
        <div class="hidden self-center text-center sm:block" data-gap>시차 계산 중…</div>
        <div class="text-right">DARMSTADT <span class="text-[18px] leading-none">🇩🇪</span><br /><b class="text-[15px] text-white sm:text-[18px]" data-clock="Europe/Berlin">--:--</b> <span data-tzname>MEZ</span></div>
      </div>
    </div>

    <!-- 검색 -->
    <form action={href("/search/")} method="get" role="search" class="rise d3 mt-9 flex max-w-[620px] items-center gap-2 rounded-[20px] border border-white/15 bg-white/[0.07] p-1.5 pl-4 backdrop-blur-md focus-within:border-white/40">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="flex-none opacity-60" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <label for="hero-q" class="sr-only">검색어</label>
      <input id="hero-q" name="q" type="search" autocomplete="off" placeholder="아포스티유, 면허, 연금…" class="min-h-[44px] w-full min-w-0 bg-transparent text-[16px] text-white outline-none placeholder:text-white/40" />
      <button class="btn flex-none bg-white text-[#0b1020]">찾기</button>
    </form>
    <div class="rise d4 mt-3 flex flex-wrap gap-2 text-[13px] text-white/60">
      {["아포스티유", "면허", "연금", "Anmeldung", "인감"].map((k) => (
        <a href={href(`/search/?q=${encodeURIComponent(k)}`)} class="rounded-full border border-white/12 px-3 py-1 hover:border-white/35 hover:text-white">#{k}</a>
      ))}
    </div>

    <!-- 신뢰 현황 -->
    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-4">
      {[
        { k: "정보 카드", v: stats.cards, s: "개" },
        { k: "공식 출처 링크", v: stats.official, s: "개" },
        { k: "일부 확인", v: stats.partial, s: "장", c: "#ffb547" },
        { k: "초안 · 확인 대기", v: stats.draft, s: "장", c: "#a99bff" },
      ].map((x) => (
        <div class="p-4" style="background:var(--hero)">
          <dt class="font-mono text-[10.5px] tracking-wider text-white/50 uppercase">{x.k}</dt>
          <dd class="mt-1 text-[28px] font-extrabold tracking-tight tabular-nums" style={x.c ? `color:${x.c}` : ""}>{x.v}<span class="ml-0.5 text-[14px] font-semibold text-white/45">{x.s}</span></dd>
        </div>
      ))}
    </dl>
    <p class="mt-3 text-[12.5px] text-white/55">확인되지 않은 내용도 숨기지 않고 상태를 표시해요. 확인일은 사람이 공식 출처와 직접 대조한 날짜만 적어요. <a href={href("/status/")} class="font-semibold text-white underline underline-offset-4">현황판 보기 →</a></p>
  </div>
</section>

<script>
  function tick() {
    const now = new Date();
    for (const el of document.querySelectorAll<HTMLElement>("[data-clock]")) {
      el.textContent = new Intl.DateTimeFormat("ko-KR", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: el.dataset.clock }).format(now);
    }
    // 독일 서머타임 여부 (MEZ/MESZ)와 시차
    const off = (tz: string) => {
      const p = new Intl.DateTimeFormat("en-US", { timeZone: tz, timeZoneName: "shortOffset" }).formatToParts(now).find((x) => x.type === "timeZoneName")?.value ?? "GMT";
      const m = p.match(/GMT([+-]\d+)?/);
      return Number(m?.[1] ?? 0);
    };
    const de = off("Europe/Berlin");
    const gap = off("Asia/Seoul") - de;
    const tzn = document.querySelector("[data-tzname]");
    if (tzn) tzn.textContent = de === 2 ? "MESZ" : "MEZ";
    const g = document.querySelector("[data-gap]");
    if (g) g.textContent = `한국이 ${gap}시간 빨라요 · ${de === 2 ? "독일 서머타임" : "독일 표준시"}`;
  }
  tick();
  setInterval(tick, 20_000);
</script>
