---
import { DIRECTIONS, type Card } from "../lib/data";
interface Props { d: Card["direction"]; size?: "sm" | "md" }
const { d, size = "md" } = Astro.props;
const x = DIRECTIONS[d];
const ring = x.tone === "kr" ? "var(--kr)" : x.tone === "de" ? "var(--de)" : "var(--red)";
---
<span class:list={["inline-flex items-center gap-1.5 rounded-full font-bold whitespace-nowrap", size === "sm" ? "px-2 py-0.5 text-[11.5px]" : "px-3 py-1 text-[13px]"]}
  style={`background:color-mix(in oklab, ${ring} 12%, var(--surface));color:var(--ink);box-shadow:inset 0 0 0 1px color-mix(in oklab, ${ring} 35%, transparent)`}>
  <span aria-hidden="true">{x.flags}</span>{x.label}
</span>
